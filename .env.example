# Copy this file to .env and replace every "change-me" value.
# Never commit .env, and never reuse these values on a live site.

# Where the database lives. This default matches docker-compose.yml for local development.
DATABASE_URL="postgresql://pathrwanda:pathrwanda@localhost:5432/pathrwanda?schema=public"

# The admin account that `npm run db:seed` creates or updates.
# Use a long password you do not use anywhere else.
ADMIN_EMAIL="admin@pathrwanda.local"
ADMIN_PASSWORD="change-me"

# Demo accounts for testing. `npm run db:seed` only creates them, and the demo listings,
# when this is set. Leave it empty to skip them.
#   youth.test@pathrwanda.local      - young user
#   employer.test@pathrwanda.local   - approved employer (Demo Farms Ltd)
#   coop.test@pathrwanda.local       - approved employer (cooperative)
#   agency.test@pathrwanda.local     - approved agency
#   institute.test@pathrwanda.local  - approved training provider
#   provider.test@pathrwanda.local   - training provider waiting for approval
TEST_USER_PASSWORD="change-me"
