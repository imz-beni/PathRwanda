generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  YOUTH
  ORGANIZATION
  TRAINING_PROVIDER
  ADMIN
}

enum OrganizationType {
  EMPLOYER
  AGENCY
  TRAINING_PROVIDER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(YOUTH)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  organization  Organization?
  sectorFollows SectorFollow[]
  progress      CourseProgress[]
  savedListings SavedListing[]
  reports       ListingReport[]
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district  String?
  interests String?
  skills    Skill[]
  updatedAt DateTime @updatedAt
}

model Organization {
  id        String           @id @default(cuid())
  ownerId   String           @unique
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  type      OrganizationType
  website   String?
  status    ApprovalStatus   @default(PENDING)
  createdAt DateTime         @default(now())

  listings Listing[]
}

enum SectorStatus {
  LIVE
  COMING_SOON
}

enum ProgressStatus {
  STARTED
  COMPLETED
}

model Sector {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  overview    String
  status      SectorStatus @default(COMING_SOON)
  sortOrder   Int          @default(0)

  pathways CareerPathway[]
  skills   Skill[]
  courses  Course[]
  follows  SectorFollow[]
  listings ListingSector[]
}

model CareerPathway {
  id          String  @id @default(cuid())
  sectorId    String
  sector      Sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  title       String
  description String
  incomeNote  String?
  skills      Skill[]

  @@index([sectorId])
}

model Skill {
  id        String          @id @default(cuid())
  sectorId  String
  sector    Sector          @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  name      String
  pathways  CareerPathway[]
  profiles  Profile[]
  listings  Listing[]

  @@unique([sectorId, name])
}

model Course {
  id          String   @id @default(cuid())
  sectorId    String
  sector      Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  title       String
  provider    String
  url         String
  description String?
  isFree      Boolean  @default(true)
  linkActive  Boolean  @default(true)
  checkedAt   DateTime?

  progress CourseProgress[]

  @@index([sectorId])
}

model CourseProgress {
  userId    String
  courseId  String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status    ProgressStatus
  updatedAt DateTime       @updatedAt

  @@id([userId, courseId])
}

model SectorFollow {
  userId    String
  sectorId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector    Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, sectorId])
}
