generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  YOUTH
  ORGANIZATION
  TRAINING_PROVIDER
  ADMIN
}

enum OrganizationType {
  EMPLOYER
  AGENCY
  TRAINING_PROVIDER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           Role      @default(YOUTH)
  emailVerified  DateTime?
  ageConfirmedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile       Profile?
  organization  Organization?
  sectorFollows SectorFollow[]
  progress      CourseProgress[]
  savedListings SavedListing[]
  reports       ListingReport[]
  sessions      Session[]
  events        Event[]
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district  String?
  interests String?
  skills    Skill[]
  updatedAt DateTime @updatedAt
}

model Organization {
  id        String           @id @default(cuid())
  ownerId   String           @unique
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  type      OrganizationType
  website   String?
  status    ApprovalStatus   @default(PENDING)
  createdAt DateTime         @default(now())

  listings Listing[]
}

enum SectorStatus {
  LIVE
  COMING_SOON
}

enum ProgressStatus {
  STARTED
  COMPLETED
}

model Sector {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  overview  String
  status    SectorStatus @default(COMING_SOON)
  sortOrder Int          @default(0)

  pathways CareerPathway[]
  skills   Skill[]
  courses  Course[]
  follows  SectorFollow[]
  listings ListingSector[]
}

model CareerPathway {
  id          String  @id @default(cuid())
  sectorId    String
  sector      Sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  title       String
  description String
  incomeNote  String?
  skills      Skill[]

  @@index([sectorId])
}

model Skill {
  id       String          @id @default(cuid())
  sectorId String
  sector   Sector          @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  name     String
  pathways CareerPathway[]
  profiles Profile[]
  listings Listing[]

  @@unique([sectorId, name])
}

model Course {
  id          String    @id @default(cuid())
  sectorId    String
  sector      Sector    @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  title       String
  provider    String
  url         String
  description String?
  isFree      Boolean   @default(true)
  linkActive  Boolean   @default(true)
  checkedAt   DateTime?

  progress CourseProgress[]

  @@index([sectorId])
}

model CourseProgress {
  userId    String
  courseId  String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status    ProgressStatus
  updatedAt DateTime       @updatedAt

  @@id([userId, courseId])
}

model SectorFollow {
  userId    String
  sectorId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector    Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, sectorId])
}

enum ListingType {
  JOB
  TRAINING
  PROGRAM
}

enum ListingStatus {
  ACTIVE
  CLOSED
  REMOVED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Listing {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  type           ListingType
  description    String
  requirements   String?
  location       String?
  applyInfo      String
  closesAt       DateTime
  status         ListingStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sectors ListingSector[]
  skills  Skill[]
  saves   SavedListing[]
  reports ListingReport[]

  @@index([status, closesAt])
}

model ListingSector {
  listingId String
  sectorId  String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sector    Sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([listingId, sectorId])
}

model SavedListing {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

model ListingReport {
  id         String       @id @default(cuid())
  listingId  String
  reporterId String
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([status])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum EventType {
  SECTOR_FOLLOWED
  COURSE_LINK_CLICKED
  COURSE_STARTED
  COURSE_COMPLETED
  MATCHED_LISTING_VIEWED
}

// Lightweight usage log used to measure the MVP hypothesis (follow / click-through / matched view).
model Event {
  id        String    @id @default(cuid())
  type      EventType
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  sectorId  String?
  courseId  String?
  listingId String?
  createdAt DateTime  @default(now())

  @@index([type, createdAt])
  @@index([userId])
}
